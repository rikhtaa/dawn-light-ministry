# Environment variables — Dawn of Light Ministry
#
# This file documents variables anticipated for upcoming features so they
# are declared here ahead of implementation (see CLAUDE.md section 20).
#
# Copy this file to .env.local and fill in real values only once the
# corresponding feature is implemented. Never commit .env.local.

# --- i18n translation generation (scripts/i18n/generate.ts) ---
# Server-side/offline CLI only — never read by the Next.js app itself, never
# sent to the browser. Only needed when running `npm run i18n:generate`.
# Pick ONE provider:
# TRANSLATION_PROVIDER=google
# GOOGLE_TRANSLATE_API_KEY=
#
# TRANSLATION_PROVIDER=libretranslate
# LIBRETRANSLATE_URL=http://localhost:5000/translate
# LIBRETRANSLATE_API_KEY=
# Run a local LibreTranslate instance via Docker (downloads the en/ur
# translation models — several GB on first run):
#   docker run -ti -p 5000:5000 libretranslate/libretranslate --load-only en,ur

# --- Prayer / Contact form email delivery (lib/email/provider.ts) ---
# Provider: Resend (https://resend.com), called via plain `fetch` — no SDK
# dependency. Both variables must be set or the forms honestly report
# delivery failure rather than fake success; nothing is hardcoded. The
# destination address itself (pastornayyer@gmail.com) is not an env var —
# it's the organization's own verified fact, set in lib/organization.ts.
#
# EMAIL_PROVIDER_API_KEY=   # a Resend API key (Resend dashboard → API Keys)
# EMAIL_FROM=               # a sender address Resend has verified for this
#                            # account — either a verified custom domain
#                            # address, or Resend's own onboarding@resend.dev
#                            # for testing before a domain is verified
